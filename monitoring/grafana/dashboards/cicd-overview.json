    {
      "type": "barchart",
      "title": "GitHub Actions - build duration per run",
      "description": "Wall-clock duration of each recent run, coloured by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(cicd_run_duration_seconds{workflow=\"$workflow\"}, \"conclusion\", \"failure\", \"conclusion\", \"timed_out\")",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
