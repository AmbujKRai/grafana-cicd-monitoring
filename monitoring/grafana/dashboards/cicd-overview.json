{
  "uid": "cicd-overview",
  "title": "CI/CD Pipeline Overview",
  "description": "Single pane of glass for the GitHub Actions (cloud) and Jenkins (self-hosted) pipelines.",
  "tags": [
    "ci-cd",
    "overview"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "workflow",
        "label": "GitHub workflow",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(cicd_workflow_runs_total, workflow)",
        "definition": "label_values(cicd_workflow_runs_total, workflow)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "CI/CD Pipeline",
          "value": "CI/CD Pipeline"
        }
      },
      {
        "type": "query",
        "name": "job",
        "label": "Jenkins job",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(default_jenkins_builds_last_build_result_ordinal, jenkins_job)",
        "definition": "label_values(default_jenkins_builds_last_build_result_ordinal, jenkins_job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "taskflow-api",
          "value": "taskflow-api"
        }
      },
      {
        "type": "custom",
        "name": "window",
        "label": "Window",
        "query": "24h,7d,30d",
        "options": [
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": true
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          }
        ],
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deployments",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "green",
        "expr": "changes(cicd_deployments_total{conclusion=\"success\"}[1m]) > 0",
        "step": "30s",
        "titleFormat": "Deployed to staging",
        "useValueForTime": false
      },
      {
        "name": "Failed runs",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(cicd_workflow_runs_total{conclusion=\"failure\"}[1m]) > 0",
        "step": "30s",
        "titleFormat": "{{workflow}} failed on {{branch}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "CI/CD dashboards",
      "type": "dashboards",
      "tags": [
        "ci-cd"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Pipeline health",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "GitHub Actions - main",
      "description": "Result of the latest completed run of the selected workflow on main.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "cicd_workflow_last_run_status{workflow=\"$workflow\",branch=\"main\"}",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PASSING",
                  "color": "green"
                },
                "0": {
                  "text": "FAILING",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
