{
  "uid": "gha-performance",
  "title": "GitHub Actions - Pipeline Performance",
  "description": "Run, stage and step level performance of the GitHub Actions workflows (cicd-exporter).",
  "tags": [
    "ci-cd",
    "github-actions"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "repo",
        "label": "Repository",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(cicd_exporter_info, repository)",
        "definition": "label_values(cicd_exporter_info, repository)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 2
      },
      {
        "type": "query",
        "name": "workflow",
        "label": "Workflow",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(cicd_workflow_runs_total, workflow)",
        "definition": "label_values(cicd_workflow_runs_total, workflow)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "CI/CD Pipeline",
          "value": "CI/CD Pipeline"
        }
      },
      {
        "type": "custom",
        "name": "window",
        "label": "Window",
        "query": "24h,7d,30d",
        "options": [
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": true
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          }
        ],
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Failed runs",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(cicd_workflow_runs_total{workflow=\"$workflow\",conclusion=\"failure\"}[1m]) > 0",
        "step": "30s",
        "titleFormat": "Run failed on {{branch}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "CI/CD dashboards",
      "type": "dashboards",
      "tags": [
        "ci-cd"
      ],
      "asDropdown": false,
      "includeVars": false,
