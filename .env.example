# Copy to .env (setup-windows.ps1 does this) and adjust. .env is git-ignored.

# Repository whose GitHub Actions runs are monitored (owner/repo).
# Defaults to the "origin" remote of this clone when empty.
GITHUB_REPOSITORY=

# Optional read-only token (fine-grained, "Actions: read" on this repo). Raises the
# GitHub API limit from 60 to 5000 requests/hour so the exporter can poll every 15 s.
GITHUB_TOKEN=

# Grafana admin password (dashboards are readable without logging in).
GF_SECURITY_ADMIN_PASSWORD=admin

# Exporter polling (seconds). Defaults: 120 idle / 30 active without a token, 60 / 15 with one.
POLL_INTERVAL_SECONDS=
ACTIVE_POLL_INTERVAL_SECONDS=
